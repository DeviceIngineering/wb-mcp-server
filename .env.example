# Wildberries API Token (опционально — магазины удобнее добавлять через веб-UI /shops)
# Получить: Портал продавца WB → Настройки → Доступ к API → Создать токен
# Типы токенов:
#   - Только чтение (read) — аналитика, статистика, цены
#   - Чтение и запись (write) — обновление цен, остатков, ответы на отзывы
WB_API_TOKEN=

# Токен авторизации MCP-эндпоинтов (/sse, /messages).
# ОБЯЗАТЕЛЬНО задать при доступе из внешней сети!
# Сгенерировать: openssl rand -hex 32
# Клиент передаёт: Authorization: Bearer <токен> или ?token=<токен>
MCP_AUTH_TOKEN=

# Интервал фоновой диагностики WB API в минутах (0 = выключить)
HEALTH_CHECK_INTERVAL_MIN=30

# Директория для хранения данных (shops.json, stats.db, .encryption_key)
# DATA_DIR=/data

# Порт сервера (по умолчанию 8001)
# PORT=8001
